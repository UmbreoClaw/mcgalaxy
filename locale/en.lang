# MCGalaxy English locale file (en)
# Format: key = value
# Lines starting with # are comments and are ignored.
# {0}, {1}, {2} are positional format placeholders — keep them in translated strings.
# &X are colour codes (&S = server colour, &H = help, &T = text, &W = warning, &a = lime, &c = red, etc.)
# λNICK, λFULL, λSHORT are player name tokens used in broadcast messages — do not translate these tokens.

# ── Login / connection ───────────────────────────────────────────────────────

login.first_visit = Welcome {0}&S! This is your first visit.
login.return = Welcome back {0}&S! You've been here {1} times!
login.first_connection = λNICK &Shas connected for the first time!
login.rules_agree = &9You must read the &c/Rules &9and &c/Agree &9to them before you can build and use commands!
login.inbox_messages = You have &a{0} &Smessages in &T/Inbox
login.lowlag_on = Lowlag mode is currently &aON.
login.hidden_reminder = &8Reminder: You are still hidden.
login.still_muted = λNICK &Wis still muted from previously.
login.still_frozen = λNICK &Wis still frozen from previously.
login.already_logged_in = Already logged in!
login.reconnecting = (Reconnecting)
login.reconnecting_diff_ip = (Reconnecting from a different IP)
login.alts_known_as = λNICK &Sis lately known as: {0}

